rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return signedIn() ? myProfile().data.role : null; }
    function isAdmin() { return signedIn() && myRole() == 'ADMIN'; }
    function isTeacher() { return signedIn() && myRole() == 'TEACHER'; }
    function isStudent() { return signedIn() && myRole() == 'STUDENT'; }
    function isParent() { return signedIn() && myRole() == 'PARENT'; }
    function parentHasChild(studentId) {
      return isParent()
        && myProfile().data.childIds is string
        && (',' + myProfile().data.childIds + ',').matches('.*,' + studentId + ',.*');
    }
    function teacherOwnsClass(classId) {
      return isTeacher()
        && classId is string
        && classId != ''
        && exists(/databases/$(database)/documents/classes/$(classId))
        && (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid
          || get(/databases/$(database)/documents/classes/$(classId)).data.teacherName == myProfile().data.name
        );
    }
    function teacherOwnsStudent(studentId) {
      return isTeacher()
        && studentId is string
        && studentId != ''
        && exists(/databases/$(database)/documents/students/$(studentId))
        && (
          get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid
          || get(/databases/$(database)/documents/students/$(studentId)).data.teacherName == myProfile().data.name
          || teacherOwnsClass(get(/databases/$(database)/documents/students/$(studentId)).data.classId)
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get: if isAdmin()
                 || isTeacher()
                 || (isStudent() && (
                      resource.data.userId == request.auth.uid
                      || myProfile().data.studentId == studentId
                    ))
                 || (isParent() && resource.data.parentId == request.auth.uid)
                 || parentHasChild(studentId);
      allow list: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (isTeacher()
                        && teacherOwnsClass(request.resource.data.classId)
                        && request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin()
                    || (isTeacher()
                        && teacherOwnsClass(resource.data.classId)
                        && request.resource.data.classId == resource.data.classId
                        && request.resource.data.studentId == resource.data.studentId
                        && request.resource.data.date == resource.data.date);
      allow delete: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin()
                            || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (isTeacher()
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.targetType == 'CLASS');
      allow update, delete: if isAdmin()
                            || (isTeacher()
                                && resource.data.authorId == request.auth.uid
                                && resource.data.targetType == 'CLASS');
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
                  || (isParent() && parentHasChild(resource.data.studentId));
      allow create, update, delete: if isAdmin();
    }

    match /bookFees/{bookFeeId} {
      allow read: if isAdmin()
                  || (isTeacher() && resource.data.teacherId == request.auth.uid)
                  || (isParent() && parentHasChild(resource.data.studentId));
      allow create: if isAdmin()
                    || (isTeacher()
                        && request.resource.data.teacherId == request.auth.uid
                        && request.resource.data.amount is number
                        && request.resource.data.amount > 0);
      allow update, delete: if isAdmin()
                            || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /counseling/{counselingId} {
      allow read: if isAdmin()
                  || teacherOwnsClass(resource.data.classId)
                  || teacherOwnsStudent(resource.data.studentId)
                  || (isStudent() && myProfile().data.studentId == resource.data.studentId)
                  || (isParent() && parentHasChild(resource.data.studentId));

      allow create: if isAdmin()
                    || (isTeacher()
                        && request.resource.data.recordType == 'MONTHLY_TEACHER'
                        && request.resource.data.teacherId == request.auth.uid
                        && request.resource.data.requesterId == request.auth.uid
                        && request.resource.data.requesterRole == 'TEACHER'
                        && teacherOwnsStudent(request.resource.data.studentId))
                    || (isStudent()
                        && request.resource.data.requesterId == request.auth.uid
                        && myProfile().data.studentId == request.resource.data.studentId)
                    || (isParent()
                        && request.resource.data.requesterId == request.auth.uid
                        && parentHasChild(request.resource.data.studentId));

      allow update: if isAdmin()
                    || (isTeacher()
                        && resource.data.recordType == 'MONTHLY_TEACHER'
                        && resource.data.teacherId == request.auth.uid
                        && request.resource.data.teacherId == request.auth.uid
                        && request.resource.data.requesterId == request.auth.uid
                        && request.resource.data.requesterRole == 'TEACHER'
                        && request.resource.data.studentId == resource.data.studentId
                        && teacherOwnsStudent(resource.data.studentId))
                    || teacherOwnsClass(resource.data.classId);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
